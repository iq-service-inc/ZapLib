<?xml version="1.0"?>
<package >
  <metadata>
    <id>ZapLib</id>
    <version>2.6.0</version>
    <title>ZapLib</title>
    <authors>Zap Lin</authors>
    <owners>Zap Lin</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>
      Inspired by jQuery and Node.js, ZapLib is a lightweight C# library that helps developers accomplish complex tasks with minimal code — HTTP requests, SQL Server / Oracle queries, .NET Web API extensions, SMTP mail, regular expressions, and more.

      📚 Documentation: https://linzap.github.io/ZapLib/
      🔧 Source &amp; Issues: https://github.com/LinZap/ZapLib
    </description>
    <releaseNotes>
      v2.6.0 — Security and execution improvements. Includes:
        * BREAKING: removed DES reversible encryption methods. Use Crypto.AESEncryption / Crypto.AESDecryption instead.
        * Security: AES-CBC + HMAC-SHA256 reversible encryption, plus Fetch.ValidPlatform / [ValidPlatform] upgraded from DES to AES authorization.
        * NEW SQL fire-and-forget execution: QuickExecuteNoWait and QuickExecNoWait run in background with independent SQL connections.
        * MyLog ForceLog fallback now writes to one .force log file instead of recursive GUID-suffix files.
      v2.5.0 (previous stable) — OracleSQL, dependency CVE fixes, public method spelling aliases, and DocFX documentation site.
      v1.23.0 (legacy) — .NET Framework 4.7.2 legacy line.

      Full changelog: https://github.com/LinZap/ZapLib/blob/master/CHANGELOG.md
    </releaseNotes>
    <copyright>Copyright Zap Lin 2018-2026</copyright>
    <tags>Zap Lib API HTTP Fetch SQL NoWait Oracle WebAPI SignalR SMTP Mailer Regex JSON Crypto AES</tags>
    <projectUrl>https://linzap.github.io/ZapLib/</projectUrl>
    <readme>docs\README.md</readme>
    <license type="expression">MIT</license>
    <icon>docs\icon.png</icon>
  </metadata>
  <files>
    <file src="..\README.md" target="docs\" />
    <file src="..\icon.png" target="docs\" />
  </files>
</package>
